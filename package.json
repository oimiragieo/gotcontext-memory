{
  "name": "gotcontext-memory",
  "version": "0.9.0",
  "description": "Multi-harness disk-canonical markdown memory + HITL dreaming for Claude Code, agy, Codex, OpenCode, and Cursor",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "gotcontext-memory": "./dist/cli.js",
    "gcm": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "verify:docker": "pwsh -NoProfile -File scripts/docker-verify.ps1",
    "prepare": "npm run build"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "docs"
  ],
  "dependencies": {
    "commander": "13.1.0",
    "proper-lockfile": "4.1.2",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "22.13.10",
    "@types/proper-lockfile": "4.1.4",
    "tsx": "4.19.3",
    "typescript": "5.8.2",
    "vitest": "3.2.7"
  },
  "license": "MIT",
  "allowScripts": {
    "@biomejs/biome@1.9.4": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
